# Backend inference server settings. Copy to `.env` and adjust, or export these
# in your shell before `uvicorn backend.main:app`. All are optional -- defaults
# come from config/default.yaml. See backend/main.py for the source of truth.

# Which checkpoint (checkpoints/<CATEGORY>.pt) to serve.
FD_CATEGORY=carpet

# Input frame size fed to the model (must match how the checkpoint was trained).
# FD_IMAGE_SIZE=224

# Override the calibrated pass/fail cutoff. Unset => use the checkpoint's value.
# FD_THRESHOLD=24.0

# Heatmap cutoff (0-1 normalized) used to derive bounding boxes.
# FD_BOX_THRESHOLD=0.5

# Reject uploads larger than this many megabytes.
# FD_MAX_UPLOAD_MB=15
